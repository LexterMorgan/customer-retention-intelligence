          <datasource-dependencies datasource="federated.churn7043">
            <column datatype="string" name="[Calculation_1743849906943511]" role="dimension" type="nominal" caption="Descriptive Churn Risk Tier">
              <calculation class="tableau" formula="IF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 6 THEN &quot;Very High&quot; ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 4 THEN &quot;High&quot; ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 2 THEN &quot;Medium&quot; ELSE &quot;Low&quot; END"></calculation>
            </column>
            <column datatype="integer" name="[Calculation_999081835979815]" role="dimension" type="ordinal" caption="Risk Tier Sort">
