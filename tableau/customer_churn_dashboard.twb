      <column caption="Churn Reason" datatype="string" name="[Churn Reason]" role="dimension" type="nominal"></column>
      <column caption="Is_Churned" datatype="integer" name="[Is_Churned]" role="measure" type="quantitative"></column>
      <column caption="Is_Retained" datatype="integer" name="[Is_Retained]" role="measure" type="quantitative"></column>
      <column caption="Flag_Negative_Monthly_Charge" datatype="integer" name="[Flag_Negative_Monthly_Charge]" role="measure" type="quantitative"></column>
      <column caption="Tenure_Band" datatype="string" name="[Tenure_Band]" role="dimension" type="nominal"></column>
      <column caption="Age_Band" datatype="string" name="[Age_Band]" role="dimension" type="nominal"></column>
      <column caption="Charge_Band" datatype="string" name="[Charge_Band]" role="dimension" type="nominal"></column>
      <column caption="Add_On_Count" datatype="integer" name="[Add_On_Count]" role="measure" type="quantitative"></column>
      <column caption="Zip_Population" datatype="integer" name="[Zip_Population]" role="measure" type="quantitative"></column>
      <column caption="Offer Group" datatype="string" name="[Offer Group]" role="dimension" type="nominal"></column>
      <column caption="Charge Band" datatype="string" name="[Charge Band]" role="dimension" type="nominal"></column>
      <column caption="Existing Customer Flag" datatype="boolean" name="[Calculation_9931737171453278]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Customer Status] = &quot;Churned&quot; OR [Customer Status] = &quot;Stayed&quot;"></calculation>
      </column>
      <column caption="Churned Customer Flag" datatype="boolean" name="[Calculation_7101739740673578]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Customer Status] = &quot;Churned&quot;"></calculation>
      </column>
      <column caption="Retained Customer Flag" datatype="boolean" name="[Calculation_8459453774227029]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Customer Status] = &quot;Stayed&quot;"></calculation>
      </column>
      <column caption="Churn Rate" datatype="real" name="[Calculation_7857073668489456]" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="SUM([Is_Churned]) / (SUM([Is_Churned]) + SUM([Is_Retained]))"></calculation>
      </column>
      <column caption="Retention Rate" datatype="real" name="[Calculation_3342033787387263]" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="SUM([Is_Retained]) / (SUM([Is_Churned]) + SUM([Is_Retained]))"></calculation>
      </column>
      <column caption="Churned Count" datatype="integer" name="[Calculation_2927380802728339]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Is_Churned])"></calculation>
      </column>
      <column caption="Existing Customer Count" datatype="integer" name="[Calculation_5322326333886981]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Is_Churned]) + SUM([Is_Retained])"></calculation>
      </column>
      <column caption="Share of All Churn" datatype="real" name="[Calculation_4367346146922081]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM([Is_Churned]) / TOTAL(SUM([Is_Churned]))"></calculation>
      </column>
      <column caption="Share of Internet Churn" datatype="real" name="[Calculation_4327689610292373]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [Internet Type] != &quot;N/A&quot; AND [Is_Churned] = 1 THEN 1 ELSE 0 END) / SUM([Is_Churned])"></calculation>
      </column>
      <column caption="Monthly Recurring Value Lost" datatype="real" name="[Calculation_9127320798730009]" role="measure" type="quantitative" default-format="C1025USD">
        <calculation class="tableau" formula="SUM(IF [Customer Status] = &quot;Churned&quot; THEN [Monthly Charge] END)"></calculation>
      </column>
      <column caption="Tenure Band Sort" datatype="integer" name="[Calculation_5256280702485091]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="CASE [Tenure_Band] WHEN &quot;0-6 months&quot; THEN 1 WHEN &quot;7-12 months&quot; THEN 2 WHEN &quot;13-24 months&quot; THEN 3 WHEN &quot;25-36 months&quot; THEN 4 WHEN &quot;37-48 months&quot; THEN 5 WHEN &quot;49-72 months&quot; THEN 6 ELSE 99 END"></calculation>
      </column>
      <column caption="High Risk Intersection Flag" datatype="boolean" name="[Calculation_6581133771596206]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Contract] = &quot;Month-to-Month&quot; AND [Tenure_Band] = &quot;0-6 months&quot; AND [Internet Type] = &quot;Fiber Optic&quot;"></calculation>
      </column>
      <column caption="Risk Points" datatype="integer" name="[Calculation_1847134694004787]" role="measure" type="quantitative">
        <calculation class="tableau" formula="(IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)"></calculation>
      </column>
      <column caption="Descriptive Churn Risk Tier" datatype="string" name="[Calculation_1743849906943511]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 6 THEN &quot;Very High&quot; ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 4 THEN &quot;High&quot; ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 2 THEN &quot;Medium&quot; ELSE &quot;Low&quot; END"></calculation>
      </column>
      <column caption="Internet Customer Flag" datatype="boolean" name="[Calculation_4277769217640754]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Internet Type] != &quot;N/A&quot;"></calculation>
      </column>
      <column caption="Risk Tier Sort" datatype="integer" name="[Calculation_999081835979815]" role="dimension" type="ordinal">
        <calculation class="tableau" formula="IF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 6 THEN 1 ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 4 THEN 2 ELSEIF ((IF [Contract] = &quot;Month-to-Month&quot; THEN 3 ELSE 0 END) + (IF [Tenure_Band] = &quot;0-6 months&quot; THEN 3 ELSE 0 END) + (IF [Internet Type] = &quot;Fiber Optic&quot; THEN 2 ELSE 0 END) + (IF [Number of Dependents] = 0 THEN 1 ELSE 0 END) + (IF [Married] = &quot;No&quot; THEN 1 ELSE 0 END)) &gt;= 2 THEN 3 ELSE 4 END"></calculation>
      </column>
      <column caption="Pct of Churned" datatype="real" name="[Calculation_1917849844275305]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="COUNT([Customer ID]) / TOTAL(COUNT([Customer ID]))"></calculation>
      </column>
      <column caption="Joined Count" datatype="integer" name="[Calculation_7556870127639983]" role="measure" type="quantitative">
        <calculation class="tableau" formula="COUNTD(IF [Customer Status] = &quot;Joined&quot; THEN [Customer ID] END)"></calculation>
      </column>
      <column caption="Early Tenure M2M Flag" datatype="boolean" name="[Calculation_8725481847902988]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Contract] = &quot;Month-to-Month&quot; AND [Tenure_Band] = &quot;0-6 months&quot;"></calculation>
      </column>
      <column caption="M2M Fiber Flag" datatype="boolean" name="[Calculation_4042912612961685]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Contract] = &quot;Month-to-Month&quot; AND [Internet Type] = &quot;Fiber Optic&quot;"></calculation>
      </column>
      <column caption="Stable Two Year Flag" datatype="boolean" name="[Calculation_5753169656075032]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Contract] = &quot;Two Year&quot; AND [Tenure_Band] IN (&quot;37-48 months&quot;,&quot;49-72 months&quot;)"></calculation>
      </column>
      <column caption="M2M No Dependents Flag" datatype="boolean" name="[Calculation_2021667176350876]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Contract] = &quot;Month-to-Month&quot; AND [Number of Dependents] = 0"></calculation>
      </column>
      <column caption="Early M2M Customers" datatype="integer" name="[Calculation_5277142431191621]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [Early Tenure M2M Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="Early M2M Churn Rate" datatype="real" name="[Calculation_9277929304875765]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [Early Tenure M2M Flag] AND [Churned Customer Flag] THEN 1 END) / SUM(IF [Early Tenure M2M Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="M2M Fiber Customers" datatype="integer" name="[Calculation_1577739075581010]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [M2M Fiber Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="M2M Fiber Churn Rate" datatype="real" name="[Calculation_8650854078187456]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [M2M Fiber Flag] AND [Churned Customer Flag] THEN 1 END) / SUM(IF [M2M Fiber Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="High Risk Customers" datatype="integer" name="[Calculation_2762118802922048]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [High Risk Intersection Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="High Risk Churn Rate" datatype="real" name="[Calculation_3693056821023242]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [High Risk Intersection Flag] AND [Churned Customer Flag] THEN 1 END) / SUM(IF [High Risk Intersection Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="Stable Two Year Customers" datatype="integer" name="[Calculation_3217439265717584]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [Stable Two Year Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="Stable Two Year Churn Rate" datatype="real" name="[Calculation_3670124850301188]" role="measure" type="quantitative" default-format="p0.0%">
        <calculation class="tableau" formula="SUM(IF [Stable Two Year Flag] AND [Churned Customer Flag] THEN 1 END) / SUM(IF [Stable Two Year Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="M2M No Dep Churned" datatype="integer" name="[Calculation_2372211702430380]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [M2M No Dependents Flag] AND [Churned Customer Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="M2M Fiber Churned" datatype="integer" name="[Calculation_5616121331153999]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [M2M Fiber Flag] AND [Churned Customer Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="Early M2M Churned" datatype="integer" name="[Calculation_2307624875383252]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [Early Tenure M2M Flag] AND [Churned Customer Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="High Risk Churned" datatype="integer" name="[Calculation_9914312681852293]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [High Risk Intersection Flag] AND [Churned Customer Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="Stable Two Year Churned" datatype="integer" name="[Calculation_3166401503066649]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [Stable Two Year Flag] AND [Churned Customer Flag] THEN 1 END)"></calculation>
      </column>
      <column caption="WS_D1_TotalCustomers Text" datatype="string" name="[Calculation_3331755030668999]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(COUNT([Customer ID]))"></calculation>
      </column>
      <column caption="WS_D1_ExistingCustomers Text" datatype="string" name="[Calculation_6254653835883291]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(SUM([Is_Churned]) + SUM([Is_Retained]))"></calculation>
      </column>
      <column caption="WS_D1_Churned Text" datatype="string" name="[Calculation_3669420554129139]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(SUM([Is_Churned]))"></calculation>
      </column>
      <column caption="WS_D1_Retained Text" datatype="string" name="[Calculation_7240620836723265]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(SUM([Is_Retained]))"></calculation>
      </column>
      <column caption="WS_D1_ChurnRate Text" datatype="string" name="[Calculation_6427058768086172]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(ROUND(100*SUM([Is_Churned])/(SUM([Is_Churned])+SUM([Is_Retained])),1)) + &quot;%&quot;"></calculation>
      </column>
      <column caption="WS_D1_RetentionRate Text" datatype="string" name="[Calculation_3574879630450827]" role="measure" type="quantitative">
        <calculation class="tableau" formula="STR(ROUND(100*SUM([Is_Retained])/(SUM([Is_Churned])+SUM([Is_Retained])),1)) + &quot;%&quot;"></calculation>
      </column>
      <column caption="WS_D1_MRVL Text" datatype="string" name="[Calculation_3498923269109953]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;$&quot; + STR(ROUND(SUM(IF [Customer Status] = &quot;Churned&quot; THEN [Monthly Charge] END),2))"></calculation>
      </column>
      <column caption="WS_D2_CalloutHighRisk Text" datatype="string" name="[Calculation_7635811788182402]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;HIGH-RISK INTERSECTION&#10;M2M + 0–6 mo + Fiber Optic&#10;&#10;487 customers  ·  444 churned&#10;91.2% churn  ·  23.8% of all churn&#10;&#10;Descriptive segment — association only&quot;"></calculation>
      </column>
      <column caption="WS_D2_CalloutCompetitor Text" datatype="string" name="[Calculation_5227607216341805]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;COMPETITOR-ATTRIBUTED EXITS&#10;&#10;841 churned&#10;45.0% of all churn&#10;&#10;Self-reported exit themes&quot;"></calculation>
      </column>
      <column caption="WS_D2_CalloutM2M Text" datatype="string" name="[Calculation_7307869626579296]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;MONTH-TO-MONTH CONTRACT&#10;&#10;51.7% churn rate&#10;1,655 churned&#10;88.6% of all churn&quot;"></calculation>
      </column>
      <column caption="WS_D3_Scenario Text" datatype="string" name="[Calculation_8418147682795667]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;HYPOTHETICAL RETENTION SCENARIO&#10;Illustrative only — not a forecast or causal estimate&#10;&#10;Segment: Month-to-Month + 0–6 months + Fiber Optic (churned)&#10;Assumption: retain 10% of churned customers in segment&#10;&#10;Observed churned in segment      444&#10;Potentially retained               44&#10;Monthly value preserved     $3,524.68&#10;Annualized value preserved $42,296.22&quot;"></calculation>
      </column>
      <column caption="WS_D2_PrioritySegments Text" datatype="string" name="[Calculation_6208693067759636]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;PRIORITY SEGMENTS  ·  existing customers&#10;&#10;Early-Tenure Month-to-Month     959  ·  81.3% churn  ·  41.7% of churn&#10;Month-to-Month Fiber Optic    1,796  ·  61.6% churn  ·  59.2% of churn&#10;M2M + 0–6 mo + Fiber            487  ·  91.2% churn  ·  23.8% of churn&#10;Stable Two-Year              1,502  ·   3.1% churn  ·   2.5% of churn&quot;"></calculation>
      </column>
      <column caption="WS_D3_SegmentVolume Text" datatype="string" name="[Calculation_5916195172600244]" role="measure" type="quantitative">
        <calculation class="tableau" formula="&quot;SEGMENT CHURN VOLUME  ·  existing customers&#10;&#10;M2M No Dependents                 1,549 churned&#10;Month-to-Month Fiber Optic        1,107 churned&#10;Early-Tenure Month-to-Month         780 churned&#10;M2M + 0–6 mo + Fiber                444 churned&#10;Stable Two-Year                      46 churned&quot;"></calculation>
      </column>
    </datasource>
  </datasources>
